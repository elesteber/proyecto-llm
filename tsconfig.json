{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@backend/*": ["./src/backend/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ]
}
